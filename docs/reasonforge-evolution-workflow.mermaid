%%{init: {
    "theme": "base",
    "themeVariables": {
      "fontFamily": "Helvetica, Arial",
      "primaryColor": "#f5f7fa",
      "primaryBorderColor": "#c9d1d9",
      "lineColor": "#9aa4b2",
      "secondaryColor": "#eef2f7",
      "tertiaryColor": "#ffffff"
    }
  }}%%

  flowchart TB

  %% ══════════════════════════════
  %% Phase 1: Entry Points
  %% ══════════════════════════════
  __start__([Start ReasonForge Run]):::terminal

  entry_decision{{"Entry Mode"}}:::decision
  populate["Phase 1: Populate<br/>Generate N Diverse Candidates<br/>(Generator Persona)"]:::agent
  items_provided["Items Provided<br/>(Refinement-Only Mode)"]:::module

  __start__ --> entry_decision
  entry_decision -->|"Full Cycle"| populate
  entry_decision -->|"Refinement Only"| items_provided

  %% ══════════════════════════════
  %% State Block Emission
  %% ══════════════════════════════
  state_block_1["Emit State Block<br/>(=== EVOLUTION STATE ===)"]:::stateblock
  populate --> state_block_1
  items_provided --> state_block_1

  %% ══════════════════════════════
  %% Phase 2: SCORING Phase
  %% ══════════════════════════════
  budget_check{{"Evaluation Budget<br/>Remaining?<br/>(pop &times; gen cap)"}}:::decision
  state_block_1 --> budget_check
  budget_check -->|"Exhausted"| completed_budget["COMPLETED<br/>(budget exhausted &mdash;<br/>best available)"]:::terminal
  budget_check -->|"Yes"| scoring_phase

  scoring_phase["Phase 2: SCORING<br/>Score all pending candidates"]:::module

  subgraph score_unit ["scoreCandidate() &mdash; per candidate"]
    direction TB
    content_isolation["Content Isolation Check<br/>(treat content as untrusted data;<br/>flag adversarial manipulation)"]:::guard
    calibration["Calibration Anchor<br/>(re-state: 0.6 = acceptable,<br/>0.9+ needs justification;<br/>gen-0 best as reference)"]:::tool
    critique_agent["Critique Candidate<br/>(Strict Evaluator persona:<br/>find flaws, gaps, contradictions)"]:::agent
    judge_agent["Score Each Dimension<br/>(dynamic dimensions, each 0&ndash;1;<br/>validated against session weights)"]:::tool
    fitness_calc["Calculate Fitness<br/>(normalized weighted sum;<br/>mandatory arithmetic table)"]:::tool
    benchmark_gate{{"Benchmark<br/>Configured?"}}:::decision
    benchmark_eval["Benchmark Evaluation<br/>(normalizedAnswer<br/>includes expectedAnswer?)"]:::tool
    no_benchmark["Skip Benchmark<br/>(auto-pass)"]:::tool
    content_isolation --> calibration --> critique_agent --> judge_agent --> fitness_calc --> benchmark_gate
    benchmark_gate -->|"Yes"| benchmark_eval
    benchmark_gate -->|"No"| no_benchmark
  end

  scoring_phase --> score_unit

  %% ══════════════════════════════
  %% Post-Scoring Threshold Check
  %% ══════════════════════════════
  all_scored{{"All Candidates<br/>Scored?"}}:::decision
  benchmark_eval --> all_scored
  no_benchmark --> all_scored
  all_scored -->|"No &mdash; pending remain"| budget_check

  threshold_check{{"Threshold Met?<br/>fitness &ge; threshold<br/>AND benchmark passed<br/>(if applicable)"}}:::decision
  all_scored -->|"Yes"| threshold_check

  %% ══════════════════════════════
  %% Termination Paths
  %% ══════════════════════════════
  completed_threshold["COMPLETED<br/>(threshold met &mdash; best answer)<br/><i>includes quality confidence note</i>"]:::terminal
  completed_genlimit["COMPLETED<br/>(generation limit &mdash; best available)<br/><i>includes quality confidence note</i>"]:::terminal
  completed_stagnation["COMPLETED<br/>(stagnation &mdash; best available)<br/><i>includes quality confidence note</i>"]:::terminal

  threshold_check -->|"Yes"| completed_threshold

  %% ══════════════════════════════
  %% Phase 3: READY_TO_SELECT Phase
  %% ══════════════════════════════
  gen_limit_check{{"Generation Limit<br/>Reached?"}}:::decision
  threshold_check -->|"No"| gen_limit_check

  gen_limit_check -->|"Yes"| completed_genlimit

  stagnation_check{{"Stagnation?<br/>(best fitness &Delta; &lt; 0.02<br/>for 2 consecutive gens)"}}:::decision
  gen_limit_check -->|"No"| stagnation_check

  stagnation_recovery["Stagnation Recovery<br/>(try fresh seed OR<br/>radical mutation)"]:::agent
  stagnation_check -->|"Yes"| stagnation_recovery
  stagnation_recovery -->|"Improved"| select_phase
  stagnation_recovery -->|"Still stagnant"| completed_stagnation

  state_block_2["Emit State Block"]:::stateblock
  stagnation_check -->|"No"| state_block_2

  select_phase["Phase 3: SELECT<br/>Sort by fitness descending<br/>Keep top N survivors<br/>Eliminate rest; increment generation"]:::module
  state_block_2 --> select_phase

  %% ══════════════════════════════
  %% Phase 4: MUTATING Phase
  %% ══════════════════════════════
  state_block_3["Emit State Block"]:::stateblock
  select_phase --> state_block_3

  pop_limit_check{{"Population Limit<br/>Reached?<br/>(size + pending &lt; limit)"}}:::decision
  state_block_3 --> pop_limit_check

  mutate_step["Phase 4a: Mutate Survivor(s)<br/>(Targeted Refiner persona:<br/>address critique, improve weak dims;<br/>multiple mutations allowed)"]:::agent
  pop_limit_check -->|"Space available"| mutate_step
  pop_limit_check -->|"Limit reached"| register_new

  crossover_gate{{"Crossover?<br/>2+ survivors &amp;&amp;<br/>population space"}}:::decision
  mutate_step --> crossover_gate

  subgraph crossover_unit ["Crossover (Crossover Synthesizer persona)"]
    direction TB
    decompose["Step 1: Decompose<br/>(list top 2 strengths of each parent;<br/>identify complementary vs redundant)"]:::agent
    synthesize["Step 2: Synthesize<br/>(merge complementary strengths<br/>into coherent unified item)"]:::agent
    decompose --> synthesize
  end
  crossover_gate -->|"Yes"| crossover_unit
  crossover_gate -->|"No &mdash; skip"| register_new

  register_new["New Candidates Registered<br/>(added to pendingCandidates;<br/>parentIds tracked for lineage)"]:::tool
  crossover_unit --> register_new

  %% ══════════════════════════════
  %% Loop Back to SCORING
  %% ══════════════════════════════
  register_new -->|"status &rarr; scoring"| state_block_1

  %% ══════════════════════════════
  %% Hybrid Mode Note
  %% ══════════════════════════════
  hybrid_note["Hybrid Mode Available<br/>(delegate arithmetic + state to CLI;<br/>LLM handles creative work only)"]:::note

  %% ══════════════════════════════
  %% Styles
  %% ══════════════════════════════
  classDef module fill:#ffffff,stroke:#c9d1d9,stroke-width:1.5px,rx:12,ry:12,color:#1f2933
  classDef decision fill:#e3f2fd,stroke:#90caf9,stroke-width:1.5px,rx:12,ry:12
  classDef agent fill:#f4f6f8,stroke:#9aa4b2,stroke-width:2px,rx:18,ry:18
  classDef tool fill:#eceff1,stroke:#b0bec5,stroke-width:1.2px,rx:10,ry:10
  classDef terminal fill:#263238,color:#ffffff,stroke:#263238,stroke-width:2px,rx:15,ry:15
  classDef stateblock fill:#fff3e0,stroke:#ffb74d,stroke-width:1.5px,rx:6,ry:6,color:#e65100
  classDef guard fill:#fce4ec,stroke:#ef9a9a,stroke-width:1.5px,rx:8,ry:8,color:#c62828
  classDef note fill:#e8f5e9,stroke:#a5d6a7,stroke-width:1px,stroke-dasharray:4 2,rx:8,ry:8,color:#2e7d32

  style score_unit fill:#fafbfc,stroke:#d0d7de,stroke-width:1.5px,stroke-dasharray:6 3,rx:8,ry:8
  style crossover_unit fill:#fafbfc,stroke:#d0d7de,stroke-width:1.5px,stroke-dasharray:6 3,rx:8,ry:8
