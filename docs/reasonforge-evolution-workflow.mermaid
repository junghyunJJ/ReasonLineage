%%{init: {
    "theme": "base",
    "themeVariables": {
      "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif",
      "fontSize": "14px",
      "primaryColor": "#f8f9fa",
      "primaryBorderColor": "#495057",
      "lineColor": "#495057",
      "secondaryColor": "#e9ecef",
      "tertiaryColor": "#ffffff",
      "primaryTextColor": "#212529",
      "edgeLabelBackground": "#ffffff"
    }
  }}%%

  flowchart TB

  %% ══════════════════════════════════════════
  %% Phase 1: Classification & Entry
  %% ══════════════════════════════════════════
  __start__([Start ReasonForge Run]):::terminal

  classify["<b>Step 1.1: Classify Question</b><br/>Select category &amp; dimensions<br/><i>=== CLASSIFICATION ===</i>"]:::module
  entry_decision{{"Entry Mode"}}:::decision
  populate["<b>Phase 1: Populate</b><br/>Generate N diverse candidates<br/><i>Generator Persona</i>"]:::agent
  items_provided["<b>Items Provided</b><br/>Refinement-Only Mode"]:::module

  __start__ --> classify
  classify --> entry_decision
  entry_decision -->|"Full Cycle"| populate
  entry_decision -->|"Refinement Only"| items_provided

  %% ══════════════════════════════════════════
  %% State Block Emission
  %% ══════════════════════════════════════════
  state_block_1["Emit State Block<br/><i>=== EVOLUTION STATE ===</i>"]:::stateblock
  populate --> state_block_1
  items_provided --> state_block_1

  %% ══════════════════════════════════════════
  %% Phase 2: SCORING
  %% ══════════════════════════════════════════
  budget_check{{"Evaluation Budget<br/>Remaining?<br/><i>pop &times; gen cap</i>"}}:::decision
  state_block_1 --> budget_check
  budget_check -->|"Exhausted"| completed_budget["<b>COMPLETED</b><br/>Budget exhausted<br/><i>Best available returned</i>"]:::terminal
  budget_check -->|"Yes"| scoring_phase

  scoring_phase["<b>Phase 2: SCORING</b><br/>Score all pending candidates"]:::phase

  subgraph score_unit ["scoreCandidate() &mdash; per candidate"]
    direction TB
    content_isolation["<b>Content Isolation Check</b><br/>Treat content as untrusted data;<br/>flag adversarial manipulation"]:::guard
    calibration["<b>Calibration Anchor</b><br/>Re-state: 0.6 = acceptable,<br/>0.9+ needs justification;<br/>gen-0 best as reference"]:::tool
    critique_agent["<b>Critique Candidate</b><br/>Strict Evaluator persona:<br/>find flaws, gaps, contradictions"]:::agent
    judge_agent["<b>Score Each Dimension</b><br/>Dynamic dimensions, each 0&ndash;1;<br/>validated against session weights"]:::tool
    fitness_calc["<b>Calculate Fitness</b><br/>Normalized weighted sum;<br/>mandatory arithmetic table"]:::tool
    benchmark_gate{{"Benchmark<br/>Configured?"}}:::decision
    benchmark_eval["<b>Benchmark Evaluation</b><br/>normalizedAnswer<br/>includes expectedAnswer?"]:::tool
    no_benchmark["Skip Benchmark<br/><i>auto-pass</i>"]:::tool
    content_isolation --> calibration --> critique_agent --> judge_agent --> fitness_calc --> benchmark_gate
    benchmark_gate -->|"Yes"| benchmark_eval
    benchmark_gate -->|"No"| no_benchmark
  end

  scoring_phase --> score_unit

  %% ══════════════════════════════════════════
  %% Post-Scoring Threshold Check
  %% ══════════════════════════════════════════
  all_scored{{"All Candidates<br/>Scored?"}}:::decision
  benchmark_eval --> all_scored
  no_benchmark --> all_scored
  all_scored -->|"No &mdash; pending remain"| budget_check

  threshold_check{{"Threshold Met?<br/><i>fitness &ge; threshold</i><br/><i>AND benchmark passed</i>"}}:::decision
  all_scored -->|"Yes"| threshold_check

  %% ══════════════════════════════════════════
  %% Termination Paths
  %% ══════════════════════════════════════════
  completed_threshold["<b>COMPLETED</b><br/>Threshold met<br/><i>Best answer with confidence</i>"]:::terminal
  completed_genlimit["<b>COMPLETED</b><br/>Generation limit reached<br/><i>Best available with confidence</i>"]:::terminal
  completed_stagnation["<b>COMPLETED</b><br/>Stagnation detected<br/><i>Best available with confidence</i>"]:::terminal

  threshold_check -->|"Yes"| completed_threshold

  %% ══════════════════════════════════════════
  %% Phase 3: READY_TO_SELECT
  %% ══════════════════════════════════════════
  gen_limit_check{{"Generation Limit<br/>Reached?"}}:::decision
  threshold_check -->|"No"| gen_limit_check

  gen_limit_check -->|"Yes"| completed_genlimit

  stagnation_check{{"Stagnation?<br/><i>best fitness &Delta; &lt; 0.02</i><br/><i>for 2 consecutive gens</i>"}}:::decision
  gen_limit_check -->|"No"| stagnation_check

  stagnation_recovery["<b>Stagnation Recovery</b><br/>Try fresh seed OR<br/>radical mutation"]:::agent
  stagnation_check -->|"Yes"| stagnation_recovery
  stagnation_recovery -->|"Improved"| select_phase
  stagnation_recovery -->|"Still stagnant"| completed_stagnation

  state_block_2["Emit State Block"]:::stateblock
  stagnation_check -->|"No"| state_block_2

  select_phase["<b>Phase 3: SELECT</b><br/>Sort by fitness descending;<br/>keep top N survivors;<br/>eliminate rest; increment generation"]:::phase
  state_block_2 --> select_phase

  %% ══════════════════════════════════════════
  %% Phase 4: MUTATION & CROSSOVER
  %% ══════════════════════════════════════════
  state_block_3["Emit State Block"]:::stateblock
  select_phase --> state_block_3

  pop_limit_check{{"Population Limit<br/>Reached?<br/><i>size + pending &lt; limit</i>"}}:::decision
  state_block_3 --> pop_limit_check

  mutate_step["<b>Phase 4a: Mutate Survivors</b><br/>Targeted Refiner persona:<br/>address critique, improve weak dims;<br/>multiple mutations allowed"]:::agent
  pop_limit_check -->|"Space available"| mutate_step
  pop_limit_check -->|"Limit reached"| register_new

  crossover_gate{{"Crossover?<br/><i>2+ survivors &amp;&amp;</i><br/><i>population space</i>"}}:::decision
  mutate_step --> crossover_gate

  subgraph crossover_unit ["Crossover (Crossover Synthesizer persona)"]
    direction TB
    decompose["<b>Step 1: Decompose</b><br/>List top 2 strengths of each parent;<br/>identify complementary vs redundant"]:::agent
    synthesize["<b>Step 2: Synthesize</b><br/>Merge complementary strengths<br/>into coherent unified item"]:::agent
    decompose --> synthesize
  end
  crossover_gate -->|"Yes"| crossover_unit
  crossover_gate -->|"No &mdash; skip"| register_new

  register_new["<b>New Candidates Registered</b><br/>Added to pendingCandidates;<br/>parentIds tracked for lineage"]:::tool
  crossover_unit --> register_new

  %% ══════════════════════════════════════════
  %% Loop Back to SCORING
  %% ══════════════════════════════════════════
  register_new -->|"status &rarr; scoring"| state_block_1

  %% ══════════════════════════════════════════
  %% Hybrid Mode Annotation
  %% ══════════════════════════════════════════
  hybrid_note["<b>Hybrid Mode Available</b><br/>Delegate arithmetic + state to CLI;<br/>LLM handles creative work only"]:::note

  %% ══════════════════════════════════════════
  %% Publication-Quality Styles
  %% ══════════════════════════════════════════
  classDef terminal fill:#2b2d42,color:#ffffff,stroke:#2b2d42,stroke-width:2.5px,rx:20,ry:20,font-weight:bold
  classDef phase fill:#d8e2f3,stroke:#4472c4,stroke-width:2px,rx:10,ry:10,color:#1a3a6b,font-weight:bold
  classDef module fill:#ffffff,stroke:#6c757d,stroke-width:1.5px,rx:10,ry:10,color:#212529
  classDef decision fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#5d4037
  classDef agent fill:#e8eaf6,stroke:#5c6bc0,stroke-width:2px,rx:14,ry:14,color:#283593
  classDef tool fill:#eceff1,stroke:#78909c,stroke-width:1.5px,rx:8,ry:8,color:#37474f
  classDef stateblock fill:#fff3e0,stroke:#ef6c00,stroke-width:1.5px,rx:6,ry:6,color:#bf360c,font-style:italic
  classDef guard fill:#fce4ec,stroke:#e53935,stroke-width:2px,rx:8,ry:8,color:#b71c1c
  classDef note fill:#e8f5e9,stroke:#66bb6a,stroke-width:1px,stroke-dasharray:5 3,rx:10,ry:10,color:#2e7d32,font-style:italic

  style score_unit fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray:8 4,rx:10,ry:10,color:#424242
  style crossover_unit fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,stroke-dasharray:8 4,rx:10,ry:10,color:#424242
