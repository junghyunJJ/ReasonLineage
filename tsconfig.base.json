{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@reasonforge/core": ["packages/core/src/index.ts"],
      "@reasonforge/codex": ["packages/codex/src/index.ts"],
      "@reasonforge/mcp": ["packages/mcp/src/index.ts"]
    }
  }
}
